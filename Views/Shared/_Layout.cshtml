<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeCare Tracker</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Authenticated Application Layout with Sidebar and Topbar -->
        <div class="app-container">
            <partial name="_Sidebar" />

            <div class="app-main">
                <partial name="_Topbar" />

                <main class="app-content" role="main">
                    <partial name="_ToastAlerts" />
                    @RenderBody()
                </main>

                <footer class="py-3 px-4 bg-white border-top text-muted small d-flex justify-content-between align-items-center">
                    <div>&copy; @DateTime.UtcNow.Year HomeCare &bull; Smart Home Maintenance Platform</div>
                    <div>
                        <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-secondary me-3">Privacy</a>
                        <span class="badge bg-light text-dark border">ASP.NET Core .NET 10</span>
                    </div>
                </footer>
            </div>
        </div>

        <partial name="_ConfirmationModal" />
    }
    else
    {
        <!-- Public Layout for Landing, Login, and Registration -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-gear-fill text-primary fs-4"></i>
                    <span>HomeCare</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Overview</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#how-it-works">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm px-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3 shadow-sm">
                            <i class="bi bi-person-plus me-1"></i> Get Started
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <main role="main">
            <div class="container mt-3">
                <partial name="_ToastAlerts" />
            </div>
            @RenderBody()
        </main>

        <footer class="bg-dark text-light py-5 mt-5 border-top border-secondary">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-5">
                        <h5 class="fw-bold d-flex align-items-center gap-2 text-white">
                            <i class="bi bi-house-gear-fill text-primary"></i> HomeCare
                        </h5>
                        <p class="text-secondary small mt-2">
                            The centralized smart home appliance maintenance system. Keep track of warranties, scheduled service, documents, invoices, health scores, and QR codes across all your properties.
                        </p>
                    </div>
                    <div class="col-6 col-md-3">
                        <h6 class="text-uppercase small text-muted fw-bold mb-3">Navigation</h6>
                        <ul class="list-unstyled small">
                            <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Home</a></li>
                            <li class="mb-2"><a asp-controller="Account" asp-action="Register" class="text-secondary text-decoration-none">Create Account</a></li>
                            <li class="mb-2"><a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none">Sign In</a></li>
                            <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-md-4">
                        <h6 class="text-uppercase small text-muted fw-bold mb-3">Technology</h6>
                        <p class="text-secondary small mb-1">
                            Built with <strong>ASP.NET Core MVC</strong>, <strong>C# .NET 10</strong>, <strong>EF Core</strong>, and <strong>SQL Server</strong>.
                        </p>
                        <p class="text-secondary small">
                            Designed to run natively in <strong>Microsoft Visual Studio</strong>.
                        </p>
                    </div>
                </div>
                <div class="border-top border-secondary pt-4 mt-4 text-center text-muted small">
                    &copy; @DateTime.UtcNow.Year HomeCare Tracker. All rights reserved.
                </div>
            </div>
        </footer>
    }

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
