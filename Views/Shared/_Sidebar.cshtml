@inject IUserContext UserContext

@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<aside class="app-sidebar">
    <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
        <i class="bi bi-house-gear-fill"></i>
        <span>HomeCare</span>
    </a>

    <div class="sidebar-menu">
        <div class="sidebar-heading">Core</div>
        <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(currentCtrl == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>

        <div class="sidebar-heading">Management</div>
        <a asp-controller="Homes" asp-action="Index" class="sidebar-link @(currentCtrl == "Homes" ? "active" : "")">
            <i class="bi bi-buildings"></i>
            <span>My Homes</span>
        </a>

        <a asp-controller="Appliance" asp-action="Index" class="sidebar-link @(currentCtrl == "Appliance" && currentAction != "Create" ? "active" : "")">
            <i class="bi bi-cpu"></i>
            <span>Appliances</span>
        </a>

        <a asp-controller="Category" asp-action="Index" class="sidebar-link @(currentCtrl == "Category" ? "active" : "")">
            <i class="bi bi-tags"></i>
            <span>Categories</span>
        </a>

        <div class="sidebar-heading">Insights & Alerts</div>
        <a asp-controller="Notification" asp-action="Index" class="sidebar-link @(currentCtrl == "Notification" ? "active" : "")">
            <i class="bi bi-bell"></i>
            <span>Notifications</span>
        </a>

        <a asp-controller="Analytics" asp-action="Index" class="sidebar-link @(currentCtrl == "Analytics" ? "active" : "")">
            <i class="bi bi-graph-up-arrow"></i>
            <span>Analytics</span>
        </a>

        <div class="sidebar-heading">Account</div>
        <a asp-controller="Account" asp-action="Profile" class="sidebar-link @(currentCtrl == "Account" ? "active" : "")">
            <i class="bi bi-person-circle"></i>
            <span>User Profile</span>
        </a>

        <div class="mt-4 px-2">
            <a asp-controller="Appliance" asp-action="Create" class="btn btn-primary btn-sm w-100 py-2 shadow-sm rounded-3">
                <i class="bi bi-plus-lg me-1"></i> Add Appliance
            </a>
        </div>
    </div>

    <div class="sidebar-footer">
        <div class="d-flex align-items-center justify-content-between text-muted small">
            <div>
                <i class="bi bi-shield-check text-success me-1"></i>
                <span>Smart Tracker</span>
            </div>
            <span class="badge bg-secondary">v2.0</span>
        </div>
    </div>
</aside>
<div class="sidebar-overlay"></div>
