@inject IUserContext UserContext
@inject HomeCare.Data.HomeCareDbContext DbContext
@using Microsoft.EntityFrameworkCore

@{
    var userId = UserContext.CurrentUserId;
    var userHomes = userId.HasValue
        ? await DbContext.Homes.Where(h => h.UserId == userId.Value).OrderBy(h => h.Name).ToListAsync()
        : new List<HomeCare.Models.Home>();

    var activeHomeId = UserContext.ActiveHomeId;
    var activeHome = userHomes.FirstOrDefault(h => h.Id == activeHomeId) ?? userHomes.FirstOrDefault();
}

<header class="app-topbar">
    <div class="topbar-left">
        <button type="button" class="btn btn-outline-secondary btn-sm d-lg-none" id="sidebarToggleBtn" aria-label="Toggle Sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <!-- Home Switcher Dropdown -->
        @if (userHomes.Count > 0)
        {
            <div class="dropdown">
                <button class="btn btn-light btn-sm dropdown-toggle border d-flex align-items-center gap-2 px-3 py-1.5 rounded-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-house-door-fill text-primary"></i>
                    <span class="fw-semibold">@(activeHome != null ? activeHome.Name : "Select Home")</span>
                </button>
                <ul class="dropdown-menu shadow border-0 py-2">
                    <li class="dropdown-header text-uppercase small text-muted">Switch Active Household</li>
                    @foreach (var home in userHomes)
                    {
                        <li>
                            <form asp-controller="Dashboard" asp-action="SwitchHome" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="homeId" value="@home.Id" />
                                <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between @(home.Id == activeHome?.Id ? "active" : "")">
                                    <span><i class="bi bi-buildings me-2 text-secondary"></i>@home.Name</span>
                                    @if (home.Id == activeHome?.Id)
                                    {
                                        <i class="bi bi-check-lg text-primary ms-2"></i>
                                    }
                                </button>
                            </form>
                        </li>
                    }
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-primary small" asp-controller="Homes" asp-action="Create">
                            <i class="bi bi-plus-circle me-2"></i>+ Add New Property
                        </a>
                    </li>
                </ul>
            </div>
        }

        <!-- Global Appliance Search Form -->
        <form asp-controller="Appliance" asp-action="Index" method="get" class="d-none d-md-flex align-items-center">
            <div class="input-group input-group-sm" style="width: 280px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTerm" class="form-control bg-light border-start-0 ps-0" placeholder="Search appliances, brands..." />
            </div>
        </form>
    </div>

    <div class="topbar-right">
        <!-- Notification Bell Dropdown -->
        <div class="dropdown">
            <button class="notification-bell-btn" type="button" id="notificationBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                <i class="bi bi-bell-fill"></i>
                <span class="badge bg-danger notification-badge" id="notificationBadge" style="display: none;">0</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end notification-dropdown" id="notificationDropdownList" aria-labelledby="notificationBellBtn">
                <li class="p-3 text-center text-muted small">Loading notifications...</li>
            </ul>
        </div>

        <!-- User Profile Dropdown -->
        <div class="dropdown">
            <button class="btn btn-light btn-sm dropdown-toggle border-0 d-flex align-items-center gap-2 p-1 pe-2 rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-weight: 600; font-size: 0.85rem;">
                    @((User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U"))
                </div>
                <span class="d-none d-sm-inline fw-semibold small text-dark">@User.Identity?.Name</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2">
                <li class="px-3 py-2 border-bottom">
                    <div class="fw-bold small">@User.Identity?.Name</div>
                    <div class="text-muted" style="font-size: 0.75rem;">@UserContext.CurrentUserEmail</div>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                        <i class="bi bi-person me-2 text-primary"></i>Profile Settings
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" asp-controller="Homes" asp-action="Index">
                        <i class="bi bi-houses me-2 text-info"></i>Manage Homes
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item py-2 text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
