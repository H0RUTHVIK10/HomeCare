@{
    ViewData["Title"] = ViewBag.Title ?? "Error";
    int code = ViewBag.StatusCode ?? 500;
}

<div class="container py-5 text-center">
    <div class="card-modern shadow-sm border-0 p-5 rounded-4 mx-auto" style="max-width: 540px;">
        <div class="mb-3 text-secondary">
            @if (code == 404)
            {
                <i class="bi bi-compass fs-1 text-primary"></i>
            }
            else if (code == 403)
            {
                <i class="bi bi-shield-lock-fill fs-1 text-danger"></i>
            }
            else
            {
                <i class="bi bi-exclamation-octagon-fill fs-1 text-warning"></i>
            }
        </div>
        <h1 class="display-3 fw-bold text-dark mb-2">@code</h1>
        <h4 class="fw-semibold text-secondary mb-3">@ViewBag.Title</h4>
        <p class="text-muted small mb-4">
            @ViewBag.Message
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Go Back
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-house-door me-1"></i> HomeCare Home
            </a>
        </div>
    </div>
</div>
