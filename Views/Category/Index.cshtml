@model IEnumerable<HomeCare.Models.Category>
@{
    ViewData["Title"] = "Appliance Categories";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">Household Appliance Categories</h3>
            <p class="text-muted small mb-0">Organize household electronics, HVAC, kitchen, and plumbing systems</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-3 shadow-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Add Category
        </a>
    </div>

    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-modern h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                                <i class="bi @(string.IsNullOrWhiteSpace(cat.Icon) ? "bi-tags" : cat.Icon) fs-3"></i>
                            </div>
                            <span class="badge bg-light text-dark border">
                                @cat.Appliances.Count Appliance(s)
                            </span>
                        </div>

                        <h5 class="fw-bold text-dark mb-1">@cat.Name</h5>
                        <p class="text-muted small mb-3">
                            @(string.IsNullOrWhiteSpace(cat.Description) ? "Household equipment group." : cat.Description)
                        </p>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Appliance" asp-action="Index" asp-route-categoryId="@cat.Id" class="small text-decoration-none fw-semibold">
                                View Items &rarr;
                            </a>

                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-light" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (cat.Appliances.Count == 0)
                                {
                                    <button type="button" class="btn btn-light text-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal"
                                            data-action="@Url.Action("Delete", "Category", new { id = cat.Id })"
                                            data-item-name="@cat.Name"
                                            data-item-type="Category">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
