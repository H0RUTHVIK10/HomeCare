@model HomeCare.ViewModels.ReminderFormViewModel
@{
    ViewData["Title"] = $"Edit Reminder - {Model.ApplianceName}";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">Edit Maintenance Reminder</h3>
            <p class="text-muted small mb-0">For <strong>@Model.ApplianceName</strong> (@Model.ApplianceBrand)</p>
        </div>
        <a asp-controller="Appliance" asp-action="Details" asp-route-id="@Model.ApplianceId" asp-route-tab="reminders" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Appliance
        </a>
    </div>

    <div class="card-modern p-4" style="max-width: 650px;">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ApplianceId" />
            <input type="hidden" asp-for="ApplianceName" />
            <input type="hidden" asp-for="ApplianceBrand" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label small fw-semibold text-muted">Task / Reminder Title *</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-sm-6">
                    <label asp-for="ReminderDate" class="form-label small fw-semibold text-muted">Due Date *</label>
                    <input asp-for="ReminderDate" class="form-control" />
                    <span asp-validation-for="ReminderDate" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ReminderType" class="form-label small fw-semibold text-muted">Reminder Type</label>
                    <select asp-for="ReminderType" class="form-select">
                        <option value="Maintenance">Maintenance</option>
                        <option value="Service">Scheduled Service</option>
                        <option value="Warranty">Warranty Follow-up</option>
                        <option value="Inspection">General Inspection</option>
                        <option value="Custom">Custom Task</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label small fw-semibold text-muted">Description / Instructions</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="IsCompleted" id="isCompletedCheck" />
                <label class="form-check-label small fw-semibold" for="isCompletedCheck">
                    Mark this task as completed
                </label>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Update Reminder
                </button>
                <a asp-controller="Appliance" asp-action="Details" asp-route-id="@Model.ApplianceId" asp-route-tab="reminders" class="btn btn-outline-secondary px-3">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
