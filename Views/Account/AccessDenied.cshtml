@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card-modern max-w-500 mx-auto p-5 shadow border-0 rounded-4">
        <div class="text-danger mb-3">
            <i class="bi bi-shield-x fs-1"></i>
        </div>
        <h3 class="fw-bold mb-2">Access Denied</h3>
        <p class="text-muted small mb-4">
            You do not have permission to view or manipulate this resource. Data isolation rules prevent access across accounts.
        </p>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
