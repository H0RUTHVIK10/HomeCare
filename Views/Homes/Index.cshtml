@model HomeCare.ViewModels.HomeListViewModel
@{
    ViewData["Title"] = "My Homes & Properties";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-0 text-dark">My Properties &amp; Residences</h3>
            <p class="text-muted small mb-0">Manage multiple homes, apartments, vacation houses, and rental properties</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-3 shadow-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Add New Property
        </a>
    </div>

    <!-- Summary Stats Bar -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total Properties</div>
                    <div class="stat-value">@Model.TotalHomes</div>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-buildings"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total Household Appliances</div>
                    <div class="stat-value text-success">@Model.TotalAppliances</div>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-cpu"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total Maintenance Recorded</div>
                    <div class="stat-value text-info">₹@Model.TotalSpending.ToString("N0")</div>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Home Cards Grid -->
    <div class="row g-4">
        @foreach (var home in Model.Homes)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-modern h-100 @(home.IsCurrentActiveHome ? "border-primary border-2 shadow" : "")">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-house-door-fill text-primary fs-5"></i>
                            <h6 class="mb-0 fw-bold">@home.Name</h6>
                        </div>
                        @if (home.IsCurrentActiveHome)
                        {
                            <span class="badge bg-primary">Active Selection</span>
                        }
                        else
                        {
                            <form asp-action="SetActive" asp-route-id="@home.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                    Switch Here
                                </button>
                            </form>
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="small text-muted">
                                <span class="badge bg-light text-dark border mb-1">@home.HomeType</span>
                                <div>@(string.IsNullOrWhiteSpace(home.Address) ? "No street address recorded" : home.Address)</div>
                                @if (!string.IsNullOrWhiteSpace(home.City) || !string.IsNullOrWhiteSpace(home.State))
                                {
                                    <div>@home.City @(string.IsNullOrWhiteSpace(home.State) ? "" : $", {home.State}")</div>
                                }
                            </div>
                            <!-- Health score pill -->
                            <div class="text-end">
                                <span class="badge @home.HealthBadgeClass px-2 py-1">@home.AverageHealthScore% Health</span>
                            </div>
                        </div>

                        <!-- Mini stats -->
                        <div class="row g-2 text-center small mb-3">
                            <div class="col-4">
                                <div class="p-2 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 0.65rem;">APPLIANCES</span>
                                    <strong class="text-dark fs-6">@home.ApplianceCount</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 0.65rem;">WARRANTIES</span>
                                    <strong class="text-success fs-6">@home.ActiveWarrantiesCount</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-light rounded-3 border">
                                    <span class="text-muted d-block" style="font-size: 0.65rem;">OVERDUE</span>
                                    <strong class="@(home.OverdueMaintenanceCount > 0 ? "text-danger" : "text-secondary") fs-6">@home.OverdueMaintenanceCount</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2">
                        <a asp-action="Overview" asp-route-id="@home.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pie-chart me-1"></i> Health Overview
                        </a>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@home.Id" class="btn btn-light" title="Edit Property">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button" class="btn btn-light text-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal"
                                    data-action="@Url.Action("Delete", "Homes", new { id = home.Id })"
                                    data-item-name="@home.Name"
                                    data-item-type="Property"
                                    title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
