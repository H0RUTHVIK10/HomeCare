@model HomeCare.ViewModels.HomeOverviewViewModel
@{
    ViewData["Title"] = $"{Model.Home.Name} - Health Overview";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0 text-dark">@Model.Home.Name</h3>
                <span class="badge bg-light text-dark border">@Model.Home.HomeType</span>
            </div>
            <p class="text-muted small mb-0">
                @(string.IsNullOrWhiteSpace(Model.Home.Address) ? "No street address" : Model.Home.Address)
                @if (!string.IsNullOrWhiteSpace(Model.Home.City))
                {
                    <span>&bull; @Model.Home.City, @Model.Home.State</span>
                }
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Appliance" asp-action="Create" asp-route-homeId="@Model.Home.Id" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Appliance Here
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> All Properties
            </a>
        </div>
    </div>

    <!-- Health Overview Metrics Cards (Requirement 30) -->
    <div class="row g-3 mb-4">
        <!-- Total Appliances -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total Appliances</div>
                    <div class="stat-value">@Model.TotalAppliances</div>
                    <small class="text-muted">In this property</small>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-cpu"></i>
                </div>
            </div>
        </div>

        <!-- Active Warranties -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Active Warranties</div>
                    <div class="stat-value text-success">@Model.ActiveWarranties</div>
                    <small class="text-muted">@Model.ExpiringWarranties expiring soon</small>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
        </div>

        <!-- Overdue Maintenance -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Overdue Tasks</div>
                    <div class="stat-value @(Model.OverdueMaintenance > 0 ? "text-danger" : "text-dark")">@Model.OverdueMaintenance</div>
                    <small class="text-muted">Requires attention</small>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-alarm"></i>
                </div>
            </div>
        </div>

        <!-- Monthly Maintenance Spending -->
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Monthly Spending</div>
                    <div class="stat-value text-info">₹@Model.CurrentMonthSpending.ToString("N0")</div>
                    <small class="text-muted">₹@Model.TotalMaintenanceSpending.ToString("N0") all-time</small>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-calendar-month"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Health Score & Highlights Row -->
    <div class="row g-4 mb-4">
        <!-- Health Score Gauge -->
        <div class="col-lg-4">
            <div class="card-modern h-100 text-center p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">Property Maintenance Health</h6>
                <div class="health-gauge-circle mx-auto mb-3 @(Model.AverageHealthScore >= 70 ? "text-success" : (Model.AverageHealthScore >= 40 ? "text-warning" : "text-danger"))">
                    <span>@Model.AverageHealthScore</span>
                    <small style="font-size: 0.65rem; font-weight: normal;">OUT OF 100</small>
                </div>
                <h5 class="fw-bold mb-1">Status: @Model.HealthRating</h5>
                <p class="text-muted small mb-0">Average condition across all @Model.TotalAppliances appliance(s) in this property.</p>
            </div>
        </div>

        <!-- Property Insights -->
        <div class="col-lg-8">
            <div class="card-modern h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-lightning-charge me-2 text-warning"></i>Household Highlights</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <small class="text-muted fw-bold d-block mb-1">MOST SERVICED APPLIANCE</small>
                                <div class="fw-bold text-dark fs-6">
                                    @(Model.MostServicedApplianceName ?? "None recorded yet")
                                </div>
                                <small class="text-secondary">@Model.MostServicedCount total service and repair visits</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <small class="text-muted fw-bold d-block mb-1">MOST EXPENSIVE APPLIANCE</small>
                                <div class="fw-bold text-dark fs-6">
                                    @(Model.MostExpensiveApplianceName ?? "Not recorded")
                                </div>
                                <small class="text-secondary">@(Model.MostExpensivePrice.HasValue ? $"Purchase value: ₹{Model.MostExpensivePrice.Value:N2}" : "Price not logged")</small>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <a asp-controller="Analytics" asp-action="Index" asp-route-homeId="@Model.Home.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-graph-up me-1"></i> View Detailed Cost Analytics
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Appliances in this Home -->
    <div class="card-modern mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="bi bi-cpu me-2 text-primary"></i>Appliances in @Model.Home.Name</h6>
            <a asp-controller="Appliance" asp-action="Create" asp-route-homeId="@Model.Home.Id" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Appliance
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.Appliances.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th>Appliance</th>
                                <th>Category</th>
                                <th>Room / Location</th>
                                <th>Warranty Status</th>
                                <th>Health Score</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Appliances)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Appliance" asp-action="Details" asp-route-id="@app.Id" class="fw-bold text-dark text-decoration-none small d-block">
                                            @app.Name
                                        </a>
                                        <small class="text-muted">@app.Brand &bull; Model: @(app.ModelNumber ?? "N/A")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi @app.CategoryIcon me-1 text-primary"></i>@app.CategoryName
                                        </span>
                                    </td>
                                    <td class="small text-secondary">
                                        @(string.IsNullOrWhiteSpace(app.Location) ? "Main Room" : app.Location)
                                    </td>
                                    <td>
                                        <span class="badge @app.WarrantyBadgeClass">@app.WarrantyStatus</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold @(app.HealthScore >= 70 ? "text-success" : (app.HealthScore >= 40 ? "text-warning" : "text-danger"))">
                                            @app.HealthScore%
                                        </span>
                                        <span class="badge @app.HealthBadgeClass small ms-1">@app.HealthRating</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Appliance" asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary btn-sm py-0 px-2">
                                            View Profile &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-4">
                    <i class="bi bi-cpu empty-state-icon"></i>
                    <h6 class="empty-state-title">No appliances in this home</h6>
                    <p class="empty-state-desc small">Add appliances to start monitoring their lifecycle and maintenance.</p>
                    <a asp-controller="Appliance" asp-action="Create" asp-route-homeId="@Model.Home.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i> Add Appliance
                    </a>
                </div>
            }
        </div>
    </div>
</div>
