@model HomeCare.ViewModels.HomeFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">Edit Property Details</h3>
            <p class="text-muted small mb-0">Update address or property label</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Properties
        </a>
    </div>

    <div class="card-modern p-4" style="max-width: 700px;">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label small fw-semibold text-muted">Property Name *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HomeType" class="form-label small fw-semibold text-muted">Property Type</label>
                <select asp-for="HomeType" class="form-select">
                    <option value="Primary Residence">Primary Residence</option>
                    <option value="Rental Apartment">Rental Apartment</option>
                    <option value="Vacation Home">Vacation Home</option>
                    <option value="Office / Workspace">Office / Workspace</option>
                    <option value="Other">Other Property</option>
                </select>
                <span asp-validation-for="HomeType" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label small fw-semibold text-muted">Street Address</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-sm-5">
                    <label asp-for="City" class="form-label small fw-semibold text-muted">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
                <div class="col-sm-4">
                    <label asp-for="State" class="form-label small fw-semibold text-muted">State / Province</label>
                    <input asp-for="State" class="form-control" />
                    <span asp-validation-for="State" class="text-danger small"></span>
                </div>
                <div class="col-sm-3">
                    <label asp-for="ZipCode" class="form-label small fw-semibold text-muted">Postal / Zip</label>
                    <input asp-for="ZipCode" class="form-control" />
                    <span asp-validation-for="ZipCode" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Update Property
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-3">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
