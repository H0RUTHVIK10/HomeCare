@model IEnumerable<HomeCare.Models.Notification>
@{
    ViewData["Title"] = "Notification Center";
    int unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0 text-dark">Notification Center</h3>
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger rounded-pill">@unreadCount Unread</span>
                }
            </div>
            <p class="text-muted small mb-0">Automated warranty alerts, maintenance notices, and scheduled service warnings</p>
        </div>

        <div class="d-flex gap-2">
            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm px-3">
                        <i class="bi bi-check2-all me-1"></i> Mark All as Read
                    </button>
                </form>
            }

            @if (Model.Any())
            {
                <form asp-action="ClearAll" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-trash3 me-1"></i> Clear History
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="card-modern">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var n in Model)
                    {
                        var iconClass = n.NotificationType switch
                        {
                            "Warranty" => "bi-shield-exclamation text-warning",
                            "Maintenance" => "bi-calendar-event text-danger",
                            "Service" => "bi-wrench text-info",
                            _ => "bi-bell text-primary"
                        };

                        <div class="list-group-item d-flex align-items-center justify-content-between p-3 border-0 border-bottom @(!n.IsRead ? "bg-light" : "")">
                            <div class="d-flex align-items-center gap-3">
                                <div class="p-2.5 bg-white rounded-circle shadow-sm border">
                                    <i class="bi @iconClass fs-4"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="mb-0 fw-bold text-dark small">@n.Title</h6>
                                        <span class="badge @(!n.IsRead ? "bg-primary" : "bg-light text-muted border")" style="font-size: 0.65rem;">
                                            @(!n.IsRead ? "New" : "Read")
                                        </span>
                                        <small class="text-muted" style="font-size: 0.72rem;">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    <p class="small text-secondary mb-0">@n.Message</p>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(n.LinkUrl))
                                {
                                    <a href="@n.LinkUrl" class="btn btn-outline-primary btn-sm py-1 px-3">
                                        View Appliance &rarr;
                                    </a>
                                }

                                @if (!n.IsRead)
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@n.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-light btn-sm text-success" title="Mark as Read">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state py-5">
                    <i class="bi bi-bell-slash empty-state-icon"></i>
                    <h5 class="empty-state-title">No notifications</h5>
                    <p class="empty-state-desc small">
                        You have no alerts right now. Reminders and warranty notices will appear here automatically.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
