@model HomeCare.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Household Maintenance Dashboard";
}

<div class="container-fluid">
    <!-- Header with Welcome & Quick Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0 text-dark">Household Dashboard</h3>
                <span class="badge bg-light text-primary border px-2.5 py-1.5 rounded-pill small">
                    <i class="bi bi-geo-alt-fill me-1"></i>@Model.ActiveHomeName
                </span>
            </div>
            <p class="text-muted small mb-0">Centralized appliance health, warranties, and maintenance tracking</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Appliance" asp-action="Create" class="btn btn-primary btn-sm rounded-3 shadow-sm px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Appliance
            </a>
            <a asp-controller="Homes" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3 px-3">
                <i class="bi bi-buildings me-1"></i> My Properties
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Appliances -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total Appliances</div>
                    <div class="stat-value">@Model.TotalAppliances</div>
                    <small class="text-muted">Across @Model.TotalHomes home(s)</small>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-cpu"></i>
                </div>
            </div>
        </div>

        <!-- Active Warranties -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Active Warranties</div>
                    <div class="stat-value text-success">@Model.ActiveWarranties</div>
                    <small class="text-muted">Protected coverage</small>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
        </div>

        <!-- Expiring Soon / Alerts -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Warranty Alerts</div>
                    <div class="stat-value @(Model.ExpiringWarranties > 0 ? "text-warning" : "text-dark")">@Model.ExpiringWarranties</div>
                    <small class="text-muted">Expiring in &le;30 days</small>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
        </div>

        <!-- Maintenance Spending -->
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Maintenance Cost</div>
                    <div class="stat-value text-info">₹@Model.TotalMaintenanceSpending.ToString("N0")</div>
                    <small class="text-muted">Total recorded spend</small>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-currency-rupee"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row: Health Score & Smart Insights -->
    <div class="row g-4 mb-4">
        <!-- Household Health Indicator (Requirement 26) -->
        <div class="col-lg-4">
            <div class="card-modern h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-heart-pulse text-danger me-2"></i>Household Health Score</span>
                    <span class="badge @Model.HealthBadgeClass">@Model.HealthRating</span>
                </div>
                <div class="card-body text-center p-4">
                    <div class="health-gauge-circle mx-auto mb-3 @(Model.AverageHealthScore >= 70 ? "text-success" : (Model.AverageHealthScore >= 40 ? "text-warning" : "text-danger"))">
                        <span>@Model.AverageHealthScore</span>
                        <small style="font-size: 0.65rem; font-weight: normal;">OUT OF 100</small>
                    </div>

                    <h5 class="fw-bold mb-1">Overall Condition: @Model.HealthRating</h5>
                    <p class="text-muted small mb-3">
                        Evaluated dynamically using appliance ages, repair frequencies, service regularity, and warranty protections.
                    </p>

                    <div class="row g-2 border-top pt-3 text-center small">
                        <div class="col-6">
                            <span class="text-muted d-block">Upcoming Services</span>
                            <strong class="text-primary fs-6">@Model.UpcomingServices</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted d-block">Overdue Tasks</span>
                            <strong class="@(Model.OverdueServices > 0 ? "text-danger" : "text-success") fs-6">@Model.OverdueServices</strong>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-2 px-3 text-center">
                    <small class="text-muted" style="font-size: 0.75rem;">
                        <i class="bi bi-info-circle me-1"></i> HomeCare Maintenance Health Indicator
                    </small>
                </div>
            </div>
        </div>

        <!-- Smart Maintenance Insights (Requirement 27) -->
        <div class="col-lg-8">
            <div class="card-modern h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Smart Maintenance Insights</span>
                    <span class="badge bg-light text-dark border">Rule-Based Intelligence</span>
                </div>
                <div class="card-body p-3">
                    @if (Model.SmartInsights.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var insight in Model.SmartInsights)
                            {
                                <div class="list-group-item d-flex align-items-start gap-3 py-2.5 px-2 border-0 border-bottom">
                                    <i class="bi bi-check2-circle text-primary fs-5 mt-1 flex-shrink-0"></i>
                                    <div class="flex-grow-1">
                                        <p class="mb-0 small text-dark">@insight</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-emoji-smile fs-2 text-success d-block mb-2"></i>
                            All systems operating within normal parameters. No urgent alerts.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Third Row: Upcoming Maintenance Schedule & Warranty Alerts -->
    <div class="row g-4 mb-4">
        <!-- Upcoming Maintenance (Requirement 8) -->
        <div class="col-lg-7">
            <div class="card-modern h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-calendar-check text-primary me-2"></i>Upcoming Maintenance Schedule</span>
                    <a asp-controller="Appliance" asp-action="Index" class="small text-decoration-none">View All &rarr;</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.UpcomingMaintenance.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th>Appliance</th>
                                        <th>Task / Service</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.UpcomingMaintenance)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Appliance" asp-action="Details" asp-route-id="@item.ApplianceId" class="fw-bold text-dark text-decoration-none small d-block">
                                                    @item.ApplianceName
                                                </a>
                                                <small class="text-muted">@item.Brand &bull; @item.HomeName</small>
                                            </td>
                                            <td class="small">@item.ServiceType</td>
                                            <td>
                                                <div class="small fw-semibold">@item.DueDate.ToString("MMM dd, yyyy")</div>
                                                <small class="text-muted">
                                                    @(item.DaysRemaining < 0 ? $"{Math.Abs(item.DaysRemaining)}d overdue" : (item.DaysRemaining == 0 ? "Today" : $"in {item.DaysRemaining}d"))
                                                </small>
                                            </td>
                                            <td>
                                                <span class="badge @item.StatusBadgeClass">@item.Status</span>
                                            </td>
                                            <td class="text-end">
                                                @if (item.ReminderId.HasValue)
                                                {
                                                    <form asp-controller="Reminder" asp-action="ToggleComplete" asp-route-id="@item.ReminderId.Value" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-success btn-sm py-0 px-2" title="Mark Done">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>
                                                }
                                                <a asp-controller="Appliance" asp-action="Details" asp-route-id="@item.ApplianceId" class="btn btn-light btn-sm py-0 px-2" title="Details">
                                                    <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state py-4">
                            <i class="bi bi-calendar2-check empty-state-icon text-success"></i>
                            <h6 class="empty-state-title">No upcoming maintenance</h6>
                            <p class="empty-state-desc small">You're all caught up on maintenance schedules.</p>
                            <a asp-controller="Appliance" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                View Appliances
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Warranty Alerts (Requirement 8) -->
        <div class="col-lg-5">
            <div class="card-modern h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-shield-exclamation text-warning me-2"></i>Warranty Watchlist</span>
                    <span class="badge bg-light text-muted border">Expiry Monitor</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.WarrantyAlerts.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var alert in Model.WarrantyAlerts.Take(6))
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between p-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="p-2 rounded-3 @(alert.Status == "Expired" ? "bg-danger bg-opacity-10 text-danger" : "bg-warning bg-opacity-10 text-warning")">
                                            <i class="bi @(alert.Status == "Expired" ? "bi-shield-x" : "bi-shield-exclamation") fs-4"></i>
                                        </div>
                                        <div>
                                            <a asp-controller="Appliance" asp-action="Details" asp-route-id="@alert.ApplianceId" asp-route-tab="warranty" class="fw-bold text-dark text-decoration-none small d-block">
                                                @alert.ApplianceName
                                            </a>
                                            <small class="text-muted">@alert.Brand &bull; End: @alert.EndDate.ToString("MMM dd, yyyy")</small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge @alert.StatusBadgeClass d-block mb-1">@alert.Status</span>
                                        <small class="text-muted" style="font-size: 0.72rem;">@alert.CountdownText</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state py-4">
                            <i class="bi bi-shield-check empty-state-icon text-success"></i>
                            <h6 class="empty-state-title">All Warranties Healthy</h6>
                            <p class="empty-state-desc small">No appliances currently have expired or critically expiring warranties.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Feed (Requirement 8) -->
    <div class="card-modern mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-clock-history text-secondary me-2"></i>Recent Activity Feed</span>
            <small class="text-muted">Latest events across your properties</small>
        </div>
        <div class="card-body p-3">
            @if (Model.RecentActivities.Count > 0)
            {
                <div class="row g-3">
                    @foreach (var act in Model.RecentActivities)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 bg-light rounded-3 h-100 border">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge @act.BadgeClass"><i class="bi @act.Icon me-1"></i>@act.Title</span>
                                    <small class="text-muted" style="font-size: 0.72rem;">@act.TimeAgo</small>
                                </div>
                                <p class="small text-secondary mb-0">@act.Description</p>
                                @if (!string.IsNullOrWhiteSpace(act.LinkUrl))
                                {
                                    <a href="@act.LinkUrl" class="small text-primary text-decoration-none mt-2 d-inline-block">View details &rarr;</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                    No activity records logged yet. Add appliances or service history to populate this feed.
                </div>
            }
        </div>
    </div>
</div>
