@model HomeCare.ViewModels.ApplianceListViewModel
@{
    ViewData["Title"] = "Household Appliances";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-0 text-dark">Household Appliances</h3>
            <p class="text-muted small mb-0">Manage warranties, documents, health scores, and service logs</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-3 shadow-sm px-3">
                <i class="bi bi-plus-lg me-1"></i> Add Appliance
            </a>
        </div>
    </div>

    <!-- Filters & Search Toolbar (Requirement 24) -->
    <div class="card-modern mb-4 p-3 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <!-- Search Text -->
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search name, brand, model..." />
                </div>
            </div>

            <!-- Home Filter -->
            <div class="col-sm-6 col-md-2">
                <select name="homeId" class="form-select form-select-sm" asp-for="SelectedHomeId" asp-items="Model.HomesList">
                    <option value="">All Homes</option>
                </select>
            </div>

            <!-- Category Filter -->
            <div class="col-sm-6 col-md-2">
                <select name="categoryId" class="form-select form-select-sm" asp-for="SelectedCategoryId" asp-items="Model.CategoriesList">
                    <option value="">All Categories</option>
                </select>
            </div>

            <!-- Status Filter -->
            <div class="col-sm-6 col-md-2">
                <select name="status" class="form-select form-select-sm" asp-for="SelectedStatus">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Under Repair">Under Repair</option>
                    <option value="Retired">Retired</option>
                    <option value="Sold">Sold</option>
                </select>
            </div>

            <!-- Warranty Status Filter -->
            <div class="col-sm-6 col-md-2">
                <select name="warrantyStatus" class="form-select form-select-sm" asp-for="SelectedWarrantyStatus">
                    <option value="">All Warranties</option>
                    <option value="Active">Active</option>
                    <option value="Expiring Soon">Expiring Soon (&le;30d)</option>
                    <option value="Expired">Expired</option>
                    <option value="None">No Warranty</option>
                </select>
            </div>

            <!-- Filter Buttons -->
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100" title="Apply Filters">
                    <i class="bi bi-funnel"></i>
                </button>
                <a asp-action="Index" class="btn btn-light btn-sm border" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Appliance Items Display -->
    @if (Model.Appliances.Count > 0)
    {
        <div class="card-modern">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th style="min-width: 240px;">Appliance</th>
                            <th>Home / Location</th>
                            <th>Category</th>
                            <th>Warranty</th>
                            <th>Health Indicator</th>
                            <th>Next Service</th>
                            <th class="text-end" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.Appliances)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(app.ImagePath))
                                        {
                                            <img src="@app.ImagePath" alt="@app.Name" class="rounded-3 border object-fit-cover shadow-sm" style="width: 48px; height: 48px;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light text-primary rounded-3 border d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                                                <i class="bi @app.CategoryIcon fs-4"></i>
                                            </div>
                                        }
                                        <div>
                                            <a asp-action="Details" asp-route-id="@app.Id" class="fw-bold text-dark text-decoration-none d-block">
                                                @app.Name
                                            </a>
                                            <small class="text-muted">
                                                @app.Brand @(string.IsNullOrWhiteSpace(app.ModelNumber) ? "" : $"&bull; {app.ModelNumber}")
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(app.SerialNumber))
                                            {
                                                <div class="text-secondary" style="font-size: 0.72rem;">S/N: @app.SerialNumber</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold small text-dark d-block">@app.HomeName</span>
                                    <small class="text-muted">@(string.IsNullOrWhiteSpace(app.Location) ? "Unassigned Location" : app.Location)</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi @app.CategoryIcon me-1 text-primary"></i>@app.CategoryName
                                    </span>
                                    <div class="mt-1">
                                        <span class="badge @(app.Status == "Active" ? "bg-success bg-opacity-10 text-success" : (app.Status == "Under Repair" ? "bg-warning bg-opacity-10 text-warning" : "bg-secondary bg-opacity-10 text-secondary")) small" style="font-size: 0.7rem;">
                                            @app.Status
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @app.WarrantyBadgeClass mb-1 d-inline-block">@app.WarrantyStatus</span>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">@app.WarrantyCountdownText</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold fs-6 @(app.HealthScore >= 70 ? "text-success" : (app.HealthScore >= 40 ? "text-warning" : "text-danger"))">
                                            @app.HealthScore%
                                        </span>
                                        <span class="badge @app.HealthBadgeClass small" style="font-size: 0.7rem;">
                                            @app.HealthRating
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (app.NextServiceDate.HasValue)
                                    {
                                        <span class="small fw-semibold text-dark">@app.NextServiceDate.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None scheduled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary" title="Full Profile & Health Score">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@app.Id" class="btn btn-outline-secondary" title="Edit Appliance">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal"
                                                data-action="@Url.Action("Delete", "Appliance", new { id = app.Id })"
                                                data-item-name="@app.Name"
                                                data-item-type="Appliance"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State (Requirement 44) -->
        <div class="card-modern empty-state">
            <i class="bi bi-cpu empty-state-icon"></i>
            <h5 class="empty-state-title">No appliances found</h5>
            <p class="empty-state-desc">
                @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "You haven't registered any household appliances yet. Start by adding your first appliance." : "No appliances matched your search or filter criteria.")
            </p>
            <a asp-action="Create" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-plus-lg me-1"></i> Add Appliance
            </a>
        </div>
    }
</div>
