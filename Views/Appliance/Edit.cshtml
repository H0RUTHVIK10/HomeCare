@model HomeCare.ViewModels.ApplianceFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">Edit Appliance</h3>
            <p class="text-muted small mb-0">Update specifications, room location, or status</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Profile
        </a>
    </div>

    <div class="card-modern p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImagePath" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label small fw-semibold text-muted">Appliance Name *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Brand" class="form-label small fw-semibold text-muted">Brand / Manufacturer *</label>
                    <input asp-for="Brand" class="form-control" />
                    <span asp-validation-for="Brand" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label small fw-semibold text-muted">Category *</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoriesList">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HomeId" class="form-label small fw-semibold text-muted">Belongs to Home / Property *</label>
                    <select asp-for="HomeId" class="form-select" asp-items="Model.HomesList">
                        <option value="">-- Select Property --</option>
                    </select>
                    <span asp-validation-for="HomeId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ModelNumber" class="form-label small fw-semibold text-muted">Model Number</label>
                    <input asp-for="ModelNumber" class="form-control" />
                    <span asp-validation-for="ModelNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SerialNumber" class="form-label small fw-semibold text-muted">Serial Number</label>
                    <input asp-for="SerialNumber" class="form-control" />
                    <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Location" class="form-label small fw-semibold text-muted">Location / Room</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PurchaseDate" class="form-label small fw-semibold text-muted">Purchase Date</label>
                    <input asp-for="PurchaseDate" class="form-control" />
                    <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PurchasePrice" class="form-label small fw-semibold text-muted">Purchase Price (₹)</label>
                    <input asp-for="PurchasePrice" class="form-control" />
                    <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label small fw-semibold text-muted">Operational Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">Active (In regular use)</option>
                        <option value="Under Repair">Under Repair</option>
                        <option value="Retired">Retired / Inactive</option>
                        <option value="Sold">Sold / Disposed</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageFile" class="form-label small fw-semibold text-muted">Replace Photo (Optional)</label>
                    <input asp-for="ImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
                    {
                        <div class="mt-2 d-flex align-items-center gap-2">
                            <img src="@Model.ExistingImagePath" alt="Current image" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                            <small class="text-muted">Current photo attached</small>
                        </div>
                    }
                </div>

                <div class="col-12">
                    <label asp-for="Notes" class="form-label small fw-semibold text-muted">Notes / Maintenance Remarks</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Update Details
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-3">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
